<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>لوحة تحكم جهاز الأمان</title>
  <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" rel="stylesheet">
  <style>
    * { box-sizing: border-box; margin: 0; padding: 0; font-family: 'Segoe UI', Tahoma, sans-serif; }
    body { background: #0f172a; color: #f8fafc; min-height: 100vh; padding: 15px; }
    header { text-align: center; margin-bottom: 20px; padding: 10px; border-bottom: 1px solid #1e293b; }
    
    .ip-card { background: #1e293b; padding: 15px; border-radius: 10px; margin-bottom: 20px; display: flex; gap: 10px; align-items: center; }
    .ip-card input { flex: 1; padding: 10px; border-radius: 6px; border: 1px solid #334155; background: #0f172a; color: #fff; }
    
    nav { display: flex; background: #1e293b; border-radius: 10px; overflow: hidden; margin-bottom: 20px; }
    nav button { flex: 1; padding: 12px; border: none; background: transparent; color: #94a3b8; font-size: 15px; font-weight: bold; cursor: pointer; transition: 0.3s; }
    nav button.active { background: #3b82f6; color: white; }

    .tab-content { display: none; }
    .tab-content.active { display: block; }

    .card { background: #1e293b; padding: 20px; border-radius: 12px; margin-bottom: 15px; box-shadow: 0 4px 15px rgba(0,0,0,0.3); }
    .btn { width: 100%; padding: 12px; margin: 8px 0; border: none; border-radius: 8px; font-weight: bold; cursor: pointer; color: white; font-size: 16px; }
    .btn-arm { background: #ef4444; } .btn-disarm { background: #10b981; }
    .btn-save { background: #3b82f6; } .btn-warning { background: #f59e0b; }

    .status-badge { text-align: center; padding: 12px; border-radius: 8px; font-weight: bold; font-size: 18px; margin-bottom: 15px; }
    .armed { background: rgba(239, 68, 68, 0.2); color: #f87171; border: 1px solid #ef4444; }
    .disarmed { background: rgba(16, 185, 129, 0.2); color: #34d399; border: 1px solid #10b981; }

    .info-row { display: flex; justify-content: space-between; padding: 10px 0; border-bottom: 1px solid #334155; }
    input[type=range], input[type=password], input[type=text] { width: 100%; padding: 10px; margin-top: 8px; background: #0f172a; border: 1px solid #334155; border-radius: 6px; color: #fff; }

    /* Modal Passcode Overlay */
    #loginOverlay { position: fixed; top:0; left:0; width:100%; height:100%; background: #0f172a; display: flex; align-items: center; justify-content: center; z-index: 999; }
    .login-box { background: #1e293b; padding: 30px; border-radius: 12px; text-align: center; max-width: 350px; width: 90%; }
  </style>
</head>
<body>

  <!-- شاشة إدخال الباسورد عند الدخول -->
  <div id="loginOverlay">
    <div class="login-box">
      <i class="fa-solid fa-lock fa-3x" style="color: #3b82f6; margin-bottom: 15px;"></i>
      <h3>أدخل رمز PIN لتسجيل الدخول</h3>
      <input type="password" id="loginPin" placeholder="****" style="text-align: center; font-size: 20px;">
      <button class="btn btn-save" style="margin-top: 15px;" onclick="checkLogin()">دخول</button>
      <p id="loginError" style="color:#f87171; margin-top: 10px; display:none;">رمز PIN غير صحيح!</p>
    </div>
  </div>

  <header>
    <h2><i class="fa-solid fa-shield-halved"></i>نظام حماية متجر </h2>
  </header>

  <div class="ip-card">
    <i class="fa-solid fa-network-wired"></i>
    <input type="text" id="espIp" placeholder="أدخل IP الجهاز (مثال: 192.168.1.50)">
    <button class="btn btn-save" style="width: auto; padding: 10px 20px;" onclick="saveIp()">حفظ</button>
  </div>

  <nav>
    <button class="active" onclick="switchTab('dashboard', this)"><i class="fa-solid fa-gauge"></i> الرئيسية</button>
    <button onclick="switchTab('sensors', this)"><i class="fa-solid fa-sliders"></i> الحساسات</button>
    <button onclick="switchTab('settings', this)"><i class="fa-solid fa-gear"></i> الإعدادات</button>
  </nav>

  <!-- التبويب 1: الرئيسية -->
  <div id="dashboard" class="tab-content active">
    <div id="statusBadge" class="status-badge disarmed">جاري الاتصال...</div>
    
    <div class="card">
      <button class="btn btn-arm" onclick="sendCmd('/arm')"><i class="fa-solid fa-lock"></i> تفعيل الإنذار (ARM)</button>
      <button class="btn btn-disarm" onclick="sendCmd('/disarm')"><i class="fa-solid fa-lock-open"></i> تعطيل الإنذار (DISARM)</button>
    </div>

    <div class="card">
      <div class="info-row"><span>حالة الباب (D5):</span><b id="doorVal">-</b></div>
      <div class="info-row"><span>قراءة الحساس (POT A0):</span><b id="potVal">-</b></div>
      <div class="info-row"><span>قوة إشارة الواي فاي:</span><b id="rssiVal">-</b></div>
    </div>
  </div>

  <!-- التبويب 2: الحساسات -->
  <div id="sensors" class="tab-content">
    <div class="card">
      <h3><i class="fa-solid fa-sliders"></i> حد حساسية الحركة (Threshold)</h3>
      <br>
      <label>القيمة الحالية: <b id="sliderText" style="color:#3b82f6;">-</b></label>
      <input type="range" id="threshRange" min="0" max="1023" onchange="sendCmd('/setThreshold?value=' + this.value)" oninput="document.getElementById('sliderText').innerText=this.value">
    </div>
  </div>

  <!-- التبويب 3: الإعدادات -->
  <div id="settings" class="tab-content">
    <div class="card">
      <h3><i class="fa-solid fa-key"></i> تغيير رمز الـ PIN</h3>
      <input type="password" id="pinInput" placeholder="رمز PIN الجديد">
      <button class="btn btn-save" onclick="changePin()">حفظ الرمز</button>
    </div>

    <div class="card">
      <h3><i class="fa-solid fa-wifi"></i> إعدادات الواي فاي</h3>
      <input type="text" id="ssidInput" placeholder="اسم الشبكة (SSID)">
      <input type="password" id="passInput" placeholder="كلمة السر الجديدة">
      <button class="btn btn-warning" onclick="changeWifi()">تحديث وإعادة تشغيل الجهاز</button>
    </div>
  </div>

  <script>
    let getIp = () => localStorage.getItem('esp_ip') || '';
    let serverPin = "1234"; // سيتم تحديثه تلقائياً من الجهاز

    function checkLogin() {
      let pin = document.getElementById('loginPin').value;
      if(pin === serverPin) {
        document.getElementById('loginOverlay').style.display = 'none';
      } else {
        document.getElementById('loginError').style.display = 'block';
      }
    }

    function saveIp() {
      let ip = document.getElementById('espIp').value.trim();
      if(ip) {
        localStorage.setItem('esp_ip', ip);
        alert('تم حفظ IP بنجاح!');
        refreshData();
      }
    }

    function switchTab(tabId, btn) {
      document.querySelectorAll('.tab-content').forEach(el => el.classList.remove('active'));
      document.querySelectorAll('nav button').forEach(el => el.classList.remove('active'));
      document.getElementById(tabId).classList.add('active');
      btn.classList.add('active');
    }

    function sendCmd(path) {
      let ip = getIp();
      if(!ip) return alert('يرجى إدخال IP الجهاز أولاً!');
      fetch(`http://${ip}${path}`).catch(e => console.error(e));
    }

    function changePin() {
      let p = document.getElementById('pinInput').value;
      if(p) {
        sendCmd('/setPin?value=' + encodeURIComponent(p));
        alert('تم حفظ PIN الجديد!');
      }
    }

    function changeWifi() {
      let s = document.getElementById('ssidInput').value;
      let p = document.getElementById('passInput').value;
      if(s && p) {
        sendCmd(`/setWifi?ssid=${encodeURIComponent(s)}&pass=${encodeURIComponent(p)}`);
        alert('تم حفظ الإعدادات! الجهاز سيعيد التشغيل للاتصال بالشبكة الجديدة.');
      }
    }

    function refreshData() {
      let ip = getIp();
      if(!ip) return;

      fetch(`http://${ip}/api/data`)
        .then(res => res.json())
        .then(data => {
          serverPin = data.pin; // مزامنة الـ PIN من الجهاز
          const sb = document.getElementById('statusBadge');
          if(data.armed) {
            sb.className = 'status-badge armed';
            sb.innerText = 'نظام الأمان: مُفعل 🛡️';
          } else {
            sb.className = 'status-badge disarmed';
            sb.innerText = 'نظام الأمان: معطل 🔓';
          }

          document.getElementById('doorVal').innerText = data.door ? "مفتوح 🚪" : "مغلق 🔒";
          document.getElementById('potVal').innerText = data.pot;
          document.getElementById('rssiVal').innerText = `${data.rssi} dBm (${data.quality}%)`;
          document.getElementById('threshRange').value = data.thresh;
          document.getElementById('sliderText').innerText = data.thresh;
        })
        .catch(() => {
          document.getElementById('statusBadge').innerText = 'تعذر الاتصال بالجهاز ❌';
          document.getElementById('statusBadge').className = 'status-badge armed';
        });
    }

    if(getIp()) document.getElementById('espIp').value = getIp();
    setInterval(refreshData, 2000);
    refreshData();
  </script>
</body>
</html>
